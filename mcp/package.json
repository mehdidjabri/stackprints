{
  "name": "stackprints-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stackprints MCP servers: public (anyone's agent, read and prepare) and admin (the maintainers' agents, write).",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "dev:public": "npm run bundle && wrangler dev -c wrangler.public.jsonc",
    "dev:admin": "wrangler dev -c wrangler.admin.jsonc",
    "deploy:public": "npm run bundle && wrangler deploy -c wrangler.public.jsonc",
    "deploy:admin": "wrangler deploy -c wrangler.admin.jsonc",
    "local:admin": "npm run build:local && node dist/admin.mjs",
    "local:public": "npm run build:local && node dist/public.mjs",
    "build:local": "esbuild src/local/admin.ts src/local/public.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --out-extension:.js=.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  }
}
