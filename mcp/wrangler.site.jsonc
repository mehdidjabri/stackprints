// The site: the static export (../out, built by `npm run build` at the repo root) served as Workers
// Static Assets, with src/workers/site.ts in front for markdown twins, headers and /mcp.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stackprints",
  // Mehdi@iterationx.io's account; wrangler's login sees more than one.
  "account_id": "cb7c938acb60c65a39dd1ae55b40caef",
  "main": "src/workers/site.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Every request reaches the Worker first, so it can answer agents with markdown.
    "run_worker_first": true
  },
  // /mcp on the site's own domain is the public MCP Worker (wrangler.public.jsonc), deployed first.
  "services": [{ "binding": "MCP", "service": "stackprints-mcp" }],
  // Point stackprints.com here once the zone is on Cloudflare:
  // "routes": [{ "pattern": "stackprints.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
